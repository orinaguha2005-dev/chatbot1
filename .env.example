# Copy this file to .env and fill in your real values. Never commit .env to git.
# ------------------------------------------------------------------------

# 1) YOUR OPENAI KEY — from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) YOUR WEBSITE'S SITEMAP — used by crawler.js to read every page.
#    Just take your domain and add /sitemap.xml at the end.
SITE_SITEMAP_URL=https://your-website.com/sitemap.xml

# 3) YOUR MONGODB CONNECTION — used by ingest-extra.js (optional second source).
#    This is the full connection string from MongoDB Atlas (or your own server).
#    Example format: mongodb+srv://username:password@cluster.mongodb.net
MONGO_URI=mongodb+srv://username:password@your-cluster.mongodb.net
MONGO_DB_NAME=your_database_name
MONGO_COLLECTION=your_collection_name

# 4) PORT the backend runs on
PORT=3001

# 5) YOUR SITE'S DOMAIN — only this domain will be allowed to call the chatbot API
ALLOWED_ORIGIN=https://your-website.com
